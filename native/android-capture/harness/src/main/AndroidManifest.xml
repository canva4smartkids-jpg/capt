<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Framework-only engine harness. Permissions and the mediaProjection service are merged in from
         native/android-capture/src/main/AndroidManifest.xml by build-apk.sh. -->
    <application
        android:allowBackup="false"
        android:label="CaptureOne Engine Harness">
        <activity
            android:name="dev.captureone.harness.HarnessActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
</manifest>
