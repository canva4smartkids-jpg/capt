{
  "$id": "https://captureone.dev/schema/CapabilityReport.json",
  "title": "CapabilityReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux",
        "android",
        "android-tv",
        "google-tv",
        "tizen",
        "webos",
        "other-tv"
      ]
    },
    "osName": {
      "type": "string"
    },
    "osVersion": {
      "type": "string"
    },
    "deviceModel": {
      "type": "string"
    },
    "appVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "screenshot",
          "displayCapture",
          "windowCapture",
          "regionCapture",
          "multiDisplay",
          "videoRecording",
          "pauseResume",
          "cursorCapture",
          "microphoneAudio",
          "systemAudio",
          "separateAudioTracks",
          "h264",
          "h265",
          "hardwareEncoding",
          "globalShortcuts",
          "recordingHistory",
          "share",
          "hdmiCaptureDevice",
          "remoteControl",
          "deviceDiscovery",
          "tvNativeScreenshot",
          "fileTransfer"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "native",
              "partial",
              "companion-only",
              "external-hardware",
              "unsupported"
            ]
          },
          "reason": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "screenCapture",
                "microphone",
                "systemAudio",
                "storage",
                "notifications",
                "localNetwork"
              ]
            }
          },
          "minOsVersion": {
            "type": "string"
          }
        },
        "required": [
          "level"
        ]
      }
    },
    "encoders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codec": {
            "type": "string",
            "enum": [
              "h264",
              "h265"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "hardware": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "codec",
          "name",
          "hardware",
          "verified"
        ]
      }
    },
    "frameRates": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number",
            "const": 24
          },
          {
            "type": "number",
            "const": 30
          },
          {
            "type": "number",
            "const": 60
          }
        ]
      }
    },
    "screenshotFormats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "png",
          "jpeg"
        ]
      }
    },
    "maxRecordingResolution": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "platform",
    "osName",
    "osVersion",
    "appVersion",
    "generatedAt",
    "features",
    "encoders",
    "frameRates",
    "screenshotFormats"
  ]
}
