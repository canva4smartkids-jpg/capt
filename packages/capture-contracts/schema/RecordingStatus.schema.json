{
  "$id": "https://captureone.dev/schema/RecordingStatus.json",
  "title": "RecordingStatus",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "countdown",
        "starting",
        "recording",
        "paused",
        "stopping",
        "finalizing",
        "completed",
        "failed"
      ]
    },
    "elapsedMs": {
      "type": "number",
      "minimum": 0
    },
    "countdownRemainingSec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bytesWritten": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "framesEncoded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "framesDropped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "estimatedBytesPerMinute": {
      "type": "number",
      "minimum": 0
    },
    "freeDiskBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outputPath": {
      "type": "string"
    },
    "encoder": {
      "type": "string"
    },
    "warnings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PERMISSION_DENIED",
            "UNSUPPORTED",
            "SOURCE_NOT_FOUND",
            "SOURCE_CLOSED",
            "ENCODER_UNAVAILABLE",
            "ENCODER_FAILED",
            "STORAGE_FULL",
            "IO_ERROR",
            "INVALID_CONFIG",
            "INVALID_STATE",
            "DRM_PROTECTED",
            "INTERRUPTED",
            "DEVICE_BUSY",
            "NETWORK",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "code",
        "message",
        "recoverable"
      ]
    }
  },
  "required": [
    "sessionId",
    "state",
    "elapsedMs",
    "bytesWritten",
    "framesEncoded",
    "framesDropped"
  ]
}
