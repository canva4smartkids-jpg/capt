{
  "$id": "https://captureone.dev/schema/RemoteCommandResult.json",
  "title": "RemoteCommandResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "sessionId": {
      "type": "string"
    },
    "media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "video",
            "screenshot"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "videoCodec": {
          "type": "string",
          "enum": [
            "h264",
            "h265"
          ]
        },
        "videoBitrateKbps": {
          "type": "number",
          "minimum": 0
        },
        "audioTracks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "codec": {
                "type": "string"
              },
              "channels": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string"
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "index",
              "codec",
              "channels",
              "sampleRate"
            ]
          }
        },
        "imageFormat": {
          "type": "string",
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "container": {
          "type": "string",
          "enum": [
            "mp4",
            "png",
            "jpeg"
          ]
        },
        "sourceName": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "validation": {
          "type": "object",
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "checkedAt": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning"
                    ]
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "severity",
                  "code",
                  "message"
                ]
              }
            }
          },
          "required": [
            "valid",
            "checkedAt",
            "tool",
            "issues"
          ]
        },
        "thumbnailPath": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "fileName",
        "title",
        "createdAt",
        "sizeBytes",
        "width",
        "height",
        "container"
      ]
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "ok"
  ]
}
