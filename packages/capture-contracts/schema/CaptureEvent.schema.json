                "recording",
                "paused",
                "stopping",
                "finalizing",
                "completed",
                "failed"
              ]
            },
            "elapsedMs": {
              "type": "number",
              "minimum": 0
            },
            "countdownRemainingSec": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bytesWritten": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "framesEncoded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "framesDropped": {
