  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "state-changed"
        },
        "sessionId": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "enum": [
            "idle",
            "countdown",
            "starting",
            "recording",
            "paused",
            "stopping",
            "finalizing",
            "completed",
            "failed"
          ]
        },
        "to": {
          "type": "string",
          "enum": [
            "idle",
            "countdown",
            "starting",
            "recording",
            "paused",
            "stopping",
            "finalizing",
            "completed",
            "failed"
          ]
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "sessionId",
        "from",
        "to",
        "at"
      ]
    },
