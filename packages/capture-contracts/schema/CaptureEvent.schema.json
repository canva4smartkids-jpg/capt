                    "SOURCE_NOT_FOUND",
                    "SOURCE_CLOSED",
                    "ENCODER_UNAVAILABLE",
                    "ENCODER_FAILED",
                    "STORAGE_FULL",
                    "IO_ERROR",
                    "INVALID_CONFIG",
                    "INVALID_STATE",
                    "DRM_PROTECTED",
                    "INTERRUPTED",
                    "DEVICE_BUSY",
                    "NETWORK",
                    "INTERNAL"
