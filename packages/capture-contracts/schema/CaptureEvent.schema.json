                },
                "message": {
                  "type": "string"
                },
                "recoverable": {
                  "type": "boolean"
                },
                "details": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "code",
                "message",
                "recoverable"
              ]
            }
          },
          "required": [
            "sessionId",
            "state",
            "elapsedMs",
            "bytesWritten",
            "framesEncoded",
            "framesDropped"
