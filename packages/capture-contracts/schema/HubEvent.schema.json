{
  "$id": "https://captureone.dev/schema/HubEvent.json",
  "title": "HubEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "hub": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "number",
              "const": 1
            },
            "hubId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "platform": {
              "type": "string",
              "enum": [
                "windows",
                "macos",
                "linux",
                "android",
                "android-tv",
                "google-tv",
                "tizen",
                "webos",
                "other-tv"
              ]
            },
            "appVersion": {
              "type": "string"
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "platform": {
                  "type": "string",
                  "enum": [
                    "windows",
                    "macos",
                    "linux",
                    "android",
                    "android-tv",
                    "google-tv",
                    "tizen",
                    "webos",
                    "other-tv"
                  ]
                },
                "osName": {
                  "type": "string"
                },
                "osVersion": {
                  "type": "string"
                },
                "deviceModel": {
                  "type": "string"
                },
                "appVersion": {
                  "type": "string"
                },
                "generatedAt": {
                  "type": "string"
                },
                "features": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "enum": [
                      "screenshot",
                      "displayCapture",
                      "windowCapture",
                      "regionCapture",
                      "multiDisplay",
                      "videoRecording",
                      "pauseResume",
                      "cursorCapture",
                      "microphoneAudio",
                      "systemAudio",
                      "separateAudioTracks",
                      "h264",
                      "h265",
                      "hardwareEncoding",
                      "globalShortcuts",
                      "recordingHistory",
                      "share",
                      "hdmiCaptureDevice",
                      "remoteControl",
                      "deviceDiscovery",
                      "tvNativeScreenshot",
                      "fileTransfer"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "string",
                        "enum": [
                          "native",
                          "partial",
                          "companion-only",
                          "external-hardware",
                          "unsupported"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      },
                      "requires": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "screenCapture",
                            "microphone",
                            "systemAudio",
                            "storage",
                            "notifications",
                            "localNetwork"
                          ]
                        }
                      },
                      "minOsVersion": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "level"
                    ]
                  }
                },
                "encoders": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "codec": {
                        "type": "string",
                        "enum": [
                          "h264",
                          "h265"
                        ]
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hardware": {
                        "type": "boolean"
                      },
                      "verified": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "codec",
                      "name",
                      "hardware",
                      "verified"
                    ]
                  }
                },
                "frameRates": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 24
                      },
                      {
                        "type": "number",
                        "const": 30
                      },
                      {
                        "type": "number",
                        "const": 60
                      }
                    ]
                  }
                },
                "screenshotFormats": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "png",
                      "jpeg"
                    ]
                  }
                },
                "maxRecordingResolution": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "height": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ]
                },
                "notes": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "schemaVersion",
                "platform",
                "osName",
                "osVersion",
                "appVersion",
                "generatedAt",
                "features",
                "encoders",
                "frameRates",
                "screenshotFormats"
              ]
            }
          },
          "required": [
            "protocolVersion",
            "hubId",
            "name",
            "platform",
            "appVersion",
            "capabilities"
          ]
        }
      },
      "required": [
        "type",
        "hub"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "recording-status"
        },
        "status": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "countdown",
                    "starting",
                    "recording",
                    "paused",
                    "stopping",
                    "finalizing",
                    "completed",
                    "failed"
                  ]
                },
                "elapsedMs": {
                  "type": "number",
                  "minimum": 0
                },
                "countdownRemainingSec": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "bytesWritten": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "framesEncoded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "framesDropped": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "estimatedBytesPerMinute": {
                  "type": "number",
                  "minimum": 0
                },
                "freeDiskBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outputPath": {
                  "type": "string"
                },
                "encoder": {
                  "type": "string"
                },
                "warnings": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "PERMISSION_DENIED",
                        "UNSUPPORTED",
                        "SOURCE_NOT_FOUND",
                        "SOURCE_CLOSED",
                        "ENCODER_UNAVAILABLE",
                        "ENCODER_FAILED",
                        "STORAGE_FULL",
                        "IO_ERROR",
                        "INVALID_CONFIG",
                        "INVALID_STATE",
                        "DRM_PROTECTED",
                        "INTERRUPTED",
                        "DEVICE_BUSY",
                        "NETWORK",
                        "INTERNAL"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "recoverable": {
                      "type": "boolean"
                    },
                    "details": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "recoverable"
                  ]
                }
              },
              "required": [
                "sessionId",
                "state",
                "elapsedMs",
                "bytesWritten",
                "framesEncoded",
                "framesDropped"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "library-changed"
        }
      },
      "required": [
        "type"
      ]
    }
  ]
}
