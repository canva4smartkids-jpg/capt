{
  "$id": "https://captureone.dev/schema/CaptureSource.json",
  "title": "CaptureSource",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "display",
        "window",
        "device"
      ]
    },
    "name": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "x": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "y": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "scaleFactor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "isPrimary": {
      "type": "boolean"
    },
    "appName": {
      "type": "string"
    },
    "deviceDescriptor": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "width",
    "height"
  ]
}
