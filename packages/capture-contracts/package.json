{
  "name": "@captureone/capture-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared capture contract: capabilities, permissions, sources, recording config/state, media metadata, errors and companion protocol.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "schema",
    "presets.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema": "tsx scripts/export-schema.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "tsx": "^4.23.15",
    "@types/node": "^22.10.0"
  }
}
